/*
 * Sofle MX RGB — keymap adapted from Skeletyl v2 (36-key Corne layout)
 * OS layout: Portuguese (Brazil) ABNT2
 *
 * ─── Porting strategy ────────────────────────────────────────────────────
 *  • Skeletyl 3×5 alpha block → Sofle inner 5 columns (cols 1–5 of 6)
 *  • Sofle outer column left:  TAB / ESC / LSHIFT
 *  • Sofle outer column right: BSPC / ABNT2 ~ dead / RSHIFT
 *  • Skeletyl 3 thumb keys → middle 3 of Sofle's 5 thumb keys
 *  • Extra thumb keys: GUI outer-left, RALT outer-right
 *  • Number row (base): standard numbers + ABNT2 symbols
 *  • Encoders: vol on base/lower, brightness on raise
 *
 * ─── Layer map ───────────────────────────────────────────────────────────
 *  0 = DEFAULT   QWERTY + ABNT2 characters
 *  1 = LOWER     Numbers, symbols, Portuguese dead keys on thumb cluster
 *  2 = RAISE     Navigation, F-keys, media
 *  3 = ADJUST    Bluetooth, RGB (auto: LOWER + RAISE)
 *
 * ─── ABNT2 key cheat-sheet (ZMK scancode → ABNT2 character) ─────────────
 *  SEMI  → ç/Ç          SQT   → ~/^  (dead tilde / dead circumflex)
 *  LBKT  → ´/`  (dead)  RBKT  → [{
 *  NUHS  → }/]           INT1  → /?   (key left of RShift)
 *  GRAVE → '/"
 * ─────────────────────────────────────────────────────────────────────────
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include "keys_pt_BR.h"

/* ── Layer indices ─────────────────────────────────────────────────── */
#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    /* ── Auto-activate ADJUST when both LOWER + RAISE held ─────────── */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    /* ── Macros for accented characters (dead key + vowel) ──────────── */
    macros {
        /* ã — tilde + a */
        m_atil: m_atil {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_TILD>, <&kp A>;
        };
        /* õ — tilde + o */
        m_otil: m_otil {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_TILD>, <&kp O>;
        };
        /* â — circumflex + a */
        m_acir: m_acir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_CIRC>, <&kp A>;
        };
        /* ê — circumflex + e */
        m_ecir: m_ecir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_CIRC>, <&kp E>;
        };
        /* ô — circumflex + o */
        m_ocir: m_ocir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_CIRC>, <&kp O>;
        };
        /* á — acute + a */
        m_aacu: m_aacu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_ACUT>, <&kp A>;
        };
        /* é — acute + e */
        m_eacu: m_eacu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_ACUT>, <&kp E>;
        };
        /* í — acute + i */
        m_iacu: m_iacu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_ACUT>, <&kp I>;
        };
        /* ó — acute + o */
        m_oacu: m_oacu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_ACUT>, <&kp O>;
        };
        /* ú — acute + u */
        m_uacu: m_uacu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_ACUT>, <&kp U>;
        };
        /* à — grave + a */
        m_agrv: m_agrv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp PT_DGRV>, <&kp A>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ══════════════════════════════════════════════════════════════
         * Layer 0 — DEFAULT  (QWERTY + ABNT2)
         *
         * Physical ABNT2 layout as seen on the Sofle grid:
         *
         * ┌───────┬───┬───┬───┬───┬───┐         ┌───┬───┬───┬───┬───┬───────┐
         * │  '/"  │ 1 │ 2 │ 3 │ 4 │ 5 │         │ 6 │ 7 │ 8 │ 9 │ 0 │  -/_  │
         * ├───────┼───┼───┼───┼───┼───┤         ├───┼───┼───┼───┼───┼───────┤
         * │  TAB  │ Q │ W │ E │ R │ T │         │ Y │ U │ I │ O │ P │ BSPC  │
         * ├───────┼───┼───┼───┼───┼───┤         ├───┼───┼───┼───┼───┼───────┤
         * │  ESC  │ A │ S │ D │ F │ G │         │ H │ J │ K │ L │ Ç │~/^ dead│
         * ├───────┼───┼───┼───┼───┼───┼───┐ ┌──┼───┼───┼───┼───┼───┼───────┤
         * │ LSHFT │ Z │ X │ C │ V │ B │ENC│ │ENC│ N │ M │ , │ . │ ; │ RSHFT │
         * └───────┴───┴───┴─┬─┴─┬─┴─┬─┴─┬┘ └┬─┴─┬─┴─┬─┴─┬─┴─┬─┴───────────┘
         *                   │GUI│ALT│CTL│LWR│ENT│SPC│RSE│CTL│ALT│
         *                   └───┴───┴───┴───┘   └───┴───┴───┴───┘
         *
         * Notes:
         *  • Ç is on row 2 col 10 (where ; is on US)
         *  • ~/^ dead key is on row 2 col 11 (where ' is on US)
         *  • Bottom row col 11 (right outer) = ; (semicolon, ABNT2 has it
         *    displaced here — maps to COLON on US scancode)
         *  • Number row keeps standard ABNT2: 1-9, 0, - (same as QWERTY)
         * ══════════════════════════════════════════════════════════════ */
        default_layer {
            display-name = "default";
            bindings = <
/*  ╔ outer-L ╦══N1══╦══N2══╦══N3══╦══N4══╦══N5══╗   ╔══N6══╦══N7══╦══N8══╦══N9══╦══N0══╦ outer-R ╗ */
    &kp PT_QUOT &kp N1 &kp N2 &kp N3 &kp N4 &kp N5    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
/*  ╠ TAB     ╬══Q═══╬══W═══╬══E═══╬══R═══╬══T═══╣   ╠══Y═══╬══U═══╬══I═══╬══O═══╬══P═══╬ BSPC    ╣ */
    &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T       &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
/*  ╠ ESC     ╬══A═══╬══S═══╬══D═══╬══F═══╬══G═══╣   ╠══H═══╬══J═══╬══K═══╬══L═══╬══Ç═══╬ ~/^dead ╣ */
    &kp ESC    &kp A  &kp S  &kp D  &kp F  &kp G       &kp H  &kp J  &kp K  &kp L  &kp PT_CCED &kp PT_TILD
/*  ╠ LSHFT   ╬══Z═══╬══X═══╬══C═══╬══V═══╬══B═══╬ENC╣ ╔ENC╬══N═══╬══M═══╬══,═══╬══.═══╬══;═══╬ RSHFT   ╣ */
    &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_MUTE  &none  &kp N  &kp M  &kp COMMA &kp DOT &kp PT_SLSH &kp RSHFT
/*                   ╚ GUI  ╩ ALT  ╩ CTL  ╩ LWR  ╩ ENT ╝   ╚ SPC  ╩ RSE  ╩ CTL  ╩ ALT  ╩ GUI  ╝ */
                    &kp LGUI &kp LALT &kp LCTRL &mo LOWER &kp RET   &kp SPACE &mo RAISE &kp RCTRL &kp RALT &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ══════════════════════════════════════════════════════════════
         * Layer 1 — LOWER  (Symbols + Portuguese accented chars)
         *
         * ┌───────┬────┬────┬────┬────┬────┐         ┌────┬────┬────┬────┬────┬───────┐
         * │  F11  │ F1 │ F2 │ F3 │ F4 │ F5 │         │ F6 │ F7 │ F8 │ F9 │F10 │  F12  │
         * ├───────┼────┼────┼────┼────┼────┤         ├────┼────┼────┼────┼────┼───────┤
         * │   ~   │  ! │  @ │  # │  $ │  % │         │  ^ │  & │  * │  ( │  ) │  DEL  │
         * ├───────┼────┼────┼────┼────┼────┤         ├────┼────┼────┼────┼────┼───────┤
         * │       │  ã │  á │  é │  ê │  â │         │  ô │  ó │  ú │  í │  ç │   Ç   │
         * ├───────┼────┼────┼────┼────┼────┼───┐ ┌──┼────┼────┼────┼────┼────┼───────┤
         * │       │  à │  õ │  ´`│ [{ │ /? │   │ │   │ }] │ }] │  = │  + │  \ │       │
         * └───────┴────┴────┴─┬──┴─┬──┴─┬──┴─┬┘ └─┬─┴─┬──┴─┬──┴─┬──┴─┬──┴───────────┘
         *                     │    │    │    │(*)│   │    │    │    │    │
         *                     └────┴────┴────┴───┘   └────┴────┴────┴────┘
         * ══════════════════════════════════════════════════════════════ */
        lower_layer {
            display-name = "lower";
            bindings = <
    &kp F11    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5         &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F12
    &kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp DEL
    &trans     &m_atil    &m_aacu    &m_eacu    &m_ecir    &m_acir        &m_ocir    &m_oacu    &m_uacu    &m_iacu    &kp PT_CCED &kp PT_CCAP
    &trans     &m_agrv    &m_otil    &kp PT_ACUT &kp PT_LBRC &kp PT_SLSH  &trans     &trans     &kp PT_RCBR &kp PT_RBRC &kp EQUAL  &kp PLUS   &kp PT_BSLS &trans
                          &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ══════════════════════════════════════════════════════════════
         * Layer 2 — RAISE  (Navigation, F-keys)
         *
         * ┌────────┬──────┬──────┬──────┬──────┬──────┐         ┌──────┬──────┬──────┬──────┬──────┬────────┐
         * │ BTCLR  │ BT0  │ BT1  │ BT2  │ BT3  │ BT4  │         │      │      │      │      │      │        │
         * ├────────┼──────┼──────┼──────┼──────┼──────┤         ├──────┼──────┼──────┼──────┼──────┼────────┤
         * │        │ INS  │ PSCR │ MENU │      │      │         │ PGUP │      │  ↑   │      │      │        │
         * ├────────┼──────┼──────┼──────┼──────┼──────┤         ├──────┼──────┼──────┼──────┼──────┼────────┤
         * │        │ LALT │ LCTL │ LSFT │      │ CAPS │         │ PGDN │  ←   │  ↓   │  →   │ DEL  │  BSPC  │
         * ├────────┼──────┼──────┼──────┼──────┼──────┼───┐ ┌──┼──────┼──────┼──────┼──────┼──────┼────────┤
         * │        │ UNDO │ CUT  │ COPY │PASTE │      │   │ │   │      │ HOME │ END  │      │      │        │
         * └────────┴──────┴──────┴─┬────┴─┬────┴─┬────┴─┬─┘ └─┬─┴─┬────┴─┬────┴─┬────┴─┬────┴────────────┘
         *                          │      │      │      │      │   │      │ (*) │      │      │
         *                          └──────┴──────┴──────┴──────┘   └──────┴─────┴──────┴──────┘
         * ══════════════════════════════════════════════════════════════ */
        raise_layer {
            display-name = "raise";
            bindings = <
    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4     &trans     &trans     &trans     &trans     &trans     &trans
    &trans      &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans           &kp PG_UP  &trans     &kp UP     &trans     &trans     &trans
    &trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK         &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &kp DEL    &kp BSPC
    &trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans   &trans   &trans     &trans     &kp HOME   &kp END    &trans     &trans     &trans
                              &trans        &trans        &trans        &trans   &trans   &trans     &trans     &trans     &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp PG_UP PG_DN>;
        };

        /* ══════════════════════════════════════════════════════════════
         * Layer 3 — ADJUST  (Bluetooth, RGB — auto: LOWER + RAISE)
         * ══════════════════════════════════════════════════════════════ */
        adjust_layer {
            display-name = "adjust";
            bindings = <
    &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4             &none  &none  &none  &none  &none  &none
    &ext_power EP_TOG &rgb_ug RGB_HUD  &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF          &none  &none  &none  &none  &none  &none
    &none             &rgb_ug RGB_BRD  &rgb_ug RGB_BRI &none           &none           &none                   &none  &none  &none  &none  &none  &none
    &none             &none            &none           &none           &none           &none  &rgb_ug RGB_TOG   &none  &none  &none  &none  &none  &none  &none
                                       &none           &none           &none           &none  &none             &none  &none  &none  &none  &none
            >;
        };
    };
};
