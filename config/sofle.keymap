#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_pt_abnt2.h"

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td_paren: tap_dance_paren {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_PAREN";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp PT_LPAR>, <&kp PT_RPAR>;
        };

        td_bkt: tap_dance_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_BRACKET";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp PT_LBKT>, <&kp PT_RBKT>;
        };

        td_brc: tap_dance_brace {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_BRACE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp PT_LBRC>, <&kp PT_RBRC>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <22 34>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <13 25>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0 - BASE

        default_layer {
            display-name = "base";
            bindings = <
&kp ESC       &kp N1          &kp N2     &kp N3        &kp N4  &kp N5                               &kp N6     &kp N7  &kp N8         &kp N9     &kp N0            &kp BACKSPACE
&kp TAB       &kp Q           &kp W      &kp E         &kp R   &kp T                                &kp Y      &kp U   &kp I          &kp O      &kp P             &hm PT_ACUTE PT_CARET
&kp CAPSLOCK  &kp A           &kp S      &kp D         &kp F   &kp G                                &kp H      &kp J   &kp K          &kp L      &kp PT_C_CEDILLA  &hm PT_TILDE PT_ACUTE
&kp LSHFT     &hm LEFT_GUI Z  &kp X      &kp C         &kp V   &kp B   &kp C_MUTE    &kp C_MUTE     &kp B      &kp N   &kp M          &kp COMMA  &kp DOT           &hm PT_SLASH PT_QMARK
                              &kp LCTRL  &kp LEFT_ALT  &mo 2   &mo 1   &kp SPACE     &kp BACKSPACE  &kp ENTER  &mo 3   &kp RIGHT_ALT  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // LAYER 1 - NUMBERS / SYMBOLS

        lower_layer {
            display-name = "num";
            bindings = <
&trans  &kp F1       &kp F2     &kp F3        &kp F4         &kp F5                            &kp F6        &kp F7            &kp F8           &kp F9       &kp F10               &kp F12
&trans  &kp PT_PIPE  &kp UNDER  &kp PT_MINUS  &kp PT_EQUAL   &kp PT_PLUS                       &kp PT_LBRC   &kp PT_RBRC       &kp PT_LBKT      &kp PT_RBKT  &hm PT_QUOT PT_DQUOT  &kp PT_BACKSLASH
&trans  &kp PT_EXCL  &kp PT_AT  &kp PT_HASH   &kp PT_DOLLAR  &kp PT_PERCENT                    &kp PT_CARET  &kp PT_AMPERSAND  &kp PT_ASTERISK  &kp PT_LPAR  &kp PT_RPAR           &kp PT_SEMI
&trans  &trans       &trans     &trans        &trans         &trans          &trans    &trans  &trans        &trans            &trans           &trans       &trans                &trans
                     &trans     &trans        &trans         &trans          &trans    &trans  &trans        &trans            &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // LAYER 2 - SYMBOLS / DEAD KEYS

        sym_layer {
            display-name = "sym";
            bindings = <
&trans  &kp PT_EXCL   &kp PT_AT     &kp PT_HASH   &kp PT_DOLLAR  &kp PT_PERCENT                    &kp PT_CARET  &kp PT_AMPERSAND  &kp PT_ASTERISK  &kp PT_LPAR  &kp PT_RPAR   &trans
&trans  &kp PT_PIPE   &kp UNDER     &kp PT_MINUS  &kp PT_EQUAL   &kp PT_PLUS                       &kp PT_LBRC   &kp PT_RBRC       &kp PT_LBKT      &kp PT_RBKT  &kp PT_ACUTE  &kp PT_BACKSLASH
&trans  &kp PT_GRAVE  &kp PT_TILDE  &kp PT_CIRC   &kp PT_LT      &kp PT_GT                         &kp PT_QMARK  &kp PT_DQUOT      &kp PT_COLON     &kp PT_SEMI  &kp PT_DOT    &trans
&trans  &trans        &trans        &trans        &trans         &trans          &trans    &trans  &trans        &trans            &trans           &trans       &trans        &trans
                      &trans        &trans        &trans         &trans          &trans    &trans  &trans        &trans            &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // LAYER 3 - FUNCTION KEYS

        adjust_layer {
            display-name = "fn";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7          &kp F8          &kp F9           &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans                    &trans  &trans          &kp UP_ARROW    &trans           &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans                    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans  &trans    &trans  &trans  &kp HOME        &kp END         &trans           &trans   &bootloader
                 &trans   &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // LAYER 4 - BLUETOOTH

        bt_layer {
            display-name = "bt";
            bindings = <
&none  &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &none  &none  &none  &none  &none  &none
&none  &bt BT_CLR         &bt BT_CLR_ALL   &none            &none            &none                            &none  &none  &none  &none  &none  &out OUT_TOG
&none  &ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI                  &none  &none  &none  &none  &none  &none
&none  &rgb_ug RGB_BRD    &rgb_ug RGB_BRI  &none            &none            &rgb_ug RGB_TOG  &none    &none  &none  &none  &none  &none  &none  &none
                          &none            &none            &none            &none            &none    &none  &none  &none  &none  &none
            >;
        };
    };
};
