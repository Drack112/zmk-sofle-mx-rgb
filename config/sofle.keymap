/*
 * Sofle MX RGB — keymap adapted from Skeletyl v2 (36-key Corne layout)
 *
 * Porting strategy:
 *   - Skeletyl 3×5 alpha block → Sofle inner 5 columns (col 1-5 of 6)
 *   - Sofle outer column (col 0 left / col 5 right): Tab/Esc/Shift | Del/Quote/Enter
 *   - Sofle number row: numbers on base, F-keys on lower, BT/RGB on raise
 *   - Skeletyl 3 thumbs → middle 3 of Sofle's 5 thumb keys
 *   - Extra thumb keys: GUI (left outer), RALT (right outer)
 *   - Encoders: vol up/down on base, brightness on raise/lower
 *
 * Layer map (mirrors Skeletyl layers):
 *   0 = DEFAULT  (QWERTY)
 *   1 = LOWER    (Numbers, Symbols)
 *   2 = RAISE    (Navigation, F-keys)
 *   3 = ADJUST   (BT, RGB)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    // Activate ADJUST layer when both LOWER and RAISE are held
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // -------------------------------------------------------
        // Layer 0: DEFAULT (QWERTY)
        // Matches Skeletyl base layer, extended to Sofle grid
        //
        // ╔═══════╦═══╦═══╦═══╦═══╦═══╗         ╔═══╦═══╦═══╦═══╦═══╦═══════╗
        // ║  `    ║ 1 ║ 2 ║ 3 ║ 4 ║ 5 ║         ║ 6 ║ 7 ║ 8 ║ 9 ║ 0 ║  -    ║
        // ╠═══════╬═══╬═══╬═══╬═══╬═══╣         ╠═══╬═══╬═══╬═══╬═══╬═══════╣
        // ║  TAB  ║ Q ║ W ║ E ║ R ║ T ║         ║ Y ║ U ║ I ║ O ║ P ║  BSPC ║
        // ╠═══════╬═══╬═══╬═══╬═══╬═══╣         ╠═══╬═══╬═══╬═══╬═══╬═══════╣
        // ║  ESC  ║ A ║ S ║ D ║ F ║ G ║         ║ H ║ J ║ K ║ L ║ ; ║  '    ║
        // ╠═══════╬═══╬═══╬═══╬═══╬═══╬═══╗ ╔══╬═══╬═══╬═══╬═══╬═══╬═══════╣
        // ║ LSHFT ║ Z ║ X ║ C ║ V ║ B ║ENC║ ║ENC║ N ║ M ║ , ║ . ║ / ║ RSHFT ║
        // ╚═══════╩═══╩═══╩═╦═╩═╦═╩═╦═╩═╦═╝ ╚═╦═╩═╦═╩═╦═╩═╦═╩═╦═╩═╦═══════╝
        //                   ║GUI║ALT║CTR║LWR║ENT║ SPC║RSE║CTR║ALT║
        //                   ╚═══╩═══╩═══╩═══╝   ╚════╩═══╩═══╩═══╝
        // -------------------------------------------------------
        default_layer {
            display-name = "default";
            bindings = <
                &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5               &kp N6    &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
                &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T                &kp Y     &kp U     &kp I      &kp O     &kp P     &kp BSPC
                &kp ESC    &kp A     &kp S     &kp D     &kp F     &kp G                &kp H     &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B    &kp C_MUTE &none     &kp N     &kp M      &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                                     &kp LGUI  &kp LALT  &kp LCTRL &mo LOWER &kp RET   &kp SPACE &mo RAISE &kp RCTRL  &kp RALT  &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // -------------------------------------------------------
        // Layer 1: LOWER — Numbers, Symbols (Skeletyl lower)
        //
        // ╔═══════╦═══╦════╦════╦════╦════╗         ╔════╦════╦════╦════╦════╦═══════╗
        // ║  F11  ║F1 ║ F2 ║ F3 ║ F4 ║ F5 ║         ║ F6 ║ F7 ║ F8 ║ F9 ║F10 ║  F12  ║
        // ╠═══════╬═══╬════╬════╬════╬════╣         ╠════╬════╬════╬════╬════╬═══════╣
        // ║   ~   ║ ! ║ @  ║ #  ║ $  ║ %  ║         ║  ^ ║  & ║  * ║  ( ║  ) ║  DEL  ║
        // ╠═══════╬═══╬════╬════╬════╬════╣         ╠════╬════╬════╬════╬════╬═══════╣
        // ║       ║ 1 ║ 2  ║ 3  ║ 4  ║ 5  ║         ║  6 ║  7 ║  8 ║  9 ║  0 ║   |   ║
        // ╠═══════╬═══╬════╬════╬════╬════╬═══╗ ╔══╬════╬════╬════╬════╬════╬═══════╣
        // ║       ║   ║ _  ║ -  ║ {  ║ [  ║   ║ ║   ║ ]  ║  } ║  = ║  + ║  \ ║       ║
        // ╚═══════╩═══╩════╩═╦══╩═╦══╩═╦══╩═╦═╝ ╚═╦═╩═╦══╩═╦══╩═╦══╩═╦══╩═══════════╝
        //                    ║    ║    ║    ║(*)║   ║    ║    ║    ║    ║
        //                    ╚════╩════╩════╩═══╝   ╚════╩════╩════╩════╝
        // -------------------------------------------------------
        lower_layer {
            display-name = "lower";
            bindings = <
                &kp F11    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5               &kp F6    &kp F7    &kp F8     &kp F9    &kp F10   &kp F12
                &kp TILDE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT            &kp CARET &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
                &trans     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5               &kp N6    &kp N7    &kp N8     &kp N9    &kp N0    &kp PIPE
                &trans     &trans    &kp UNDER &kp MINUS &kp LBRC  &kp LBKT  &trans     &trans    &kp RBKT  &kp RBRC   &kp EQUAL &kp PLUS  &kp BSLH  &trans
                                     &trans    &trans    &trans    &trans    &trans      &trans    &trans    &trans     &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // -------------------------------------------------------
        // Layer 2: RAISE — Navigation, Media (Skeletyl raise)
        //
        // ╔═══════╦══════╦══════╦══════╦══════╦══════╗         ╔══════╦══════╦══════╦══════╦══════╦═══════╗
        // ║BTCLR  ║ BT0  ║ BT1  ║ BT2  ║ BT3  ║ BT4  ║         ║      ║      ║      ║      ║      ║       ║
        // ╠═══════╬══════╬══════╬══════╬══════╬══════╣         ╠══════╬══════╬══════╬══════╬══════╬═══════╣
        // ║       ║ INS  ║ PSCR ║ MENU ║      ║      ║         ║ PGUP ║      ║  ↑   ║      ║      ║       ║
        // ╠═══════╬══════╬══════╬══════╬══════╬══════╣         ╠══════╬══════╬══════╬══════╬══════╬═══════╣
        // ║       ║ LALT ║ LCTL ║ LSFT ║      ║ CAPS ║         ║ PGDN ║  ←   ║  ↓   ║  →   ║ DEL  ║ BSPC  ║
        // ╠═══════╬══════╬══════╬══════╬══════╬══════╬═══╗ ╔══╬══════╬══════╬══════╬══════╬══════╬═══════╣
        // ║       ║ UNDO ║ CUT  ║ COPY ║ PASTE║      ║   ║ ║   ║      ║      ║      ║      ║      ║       ║
        // ╚═══════╩══════╩══════╩═╦════╩═╦════╩═╦════╩═╦═╝ ╚═╦═╩═╦════╩═╦════╩═╦════╩═╦════╩═══════════╝
        //                         ║      ║      ║      ║      ║   ║      ║ (*) ║      ║      ║
        //                         ╚══════╩══════╩══════╩══════╝   ╚══════╩═════╩══════╩══════╝
        // -------------------------------------------------------
        raise_layer {
            display-name = "raise";
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4        &trans    &trans    &trans    &trans    &trans    &trans
                &trans      &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans              &kp PG_UP &trans    &kp UP    &trans    &trans    &trans
                &trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK            &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &kp DEL   &kp BSPC
                &trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                                          &trans        &trans        &trans        &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // -------------------------------------------------------
        // Layer 3: ADJUST — RGB, System (auto-activated: LOWER + RAISE)
        //
        // ╔═══════╦══════╦══════╦══════╦══════╦══════╗         ╔══════╦══════╦══════╦══════╦══════╦═══════╗
        // ║BTCLR  ║ BT0  ║ BT1  ║ BT2  ║ BT3  ║ BT4  ║         ║      ║      ║      ║      ║      ║       ║
        // ╠═══════╬══════╬══════╬══════╬══════╬══════╣         ╠══════╬══════╬══════╬══════╬══════╬═══════╣
        // ║EXTPWR ║RGB_HD║RGB_HI║RGB_SD║RGB_SI║RGB_EF║         ║      ║      ║      ║      ║      ║       ║
        // ╠═══════╬══════╬══════╬══════╬══════╬══════╣         ╠══════╬══════╬══════╬══════╬══════╬═══════╣
        // ║       ║RGB_BD║RGB_BI║      ║      ║      ║         ║      ║      ║      ║      ║      ║       ║
        // ╠═══════╬══════╬══════╬══════╬══════╬══════╬═══╗ ╔══╬══════╬══════╬══════╬══════╬══════╬═══════╣
        // ║       ║      ║      ║      ║      ║      ║TOG║ ║   ║      ║      ║      ║      ║      ║       ║
        // ╚═══════╩══════╩══════╩═╦════╩═╦════╩═╦════╩═╦═╝ ╚═╦═╩═╦════╩═╦════╩═╦════╩═╦════╩═══════════╝
        //                         ║      ║      ║      ║      ║   ║      ║      ║      ║      ║
        //                         ╚══════╩══════╩══════╩══════╝   ╚══════╩══════╩══════╩══════╝
        // -------------------------------------------------------
        adjust_layer {
            display-name = "adjust";
            bindings = <
                &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4             &none  &none  &none  &none  &none  &none
                &ext_power EP_TOG &rgb_ug RGB_HUD  &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF          &none  &none  &none  &none  &none  &none
                &none             &rgb_ug RGB_BRD  &rgb_ug RGB_BRI &none           &none           &none                   &none  &none  &none  &none  &none  &none
                &none             &none            &none           &none           &none           &none  &rgb_ug RGB_TOG   &none  &none  &none  &none  &none  &none  &none
                                                   &none           &none           &none           &none  &none             &none  &none  &none  &none  &none
            >;
        };
    };
};
